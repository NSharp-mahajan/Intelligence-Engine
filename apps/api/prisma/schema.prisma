datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  clerkId      String?   @unique
  email        String    @unique
  passwordHash String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  profile      Profile?
  sessions     Session[]
}

model Profile {
  id             String           @id @default(uuid())
  userId         String           @unique
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  university     String?
  graduationYear Int?
  targetRole     String?
  githubUrl      String?
  linkedinUrl    String?
  portfolioUrl   String?
  resumeUrl      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  candidateSkills CandidateSkill[]
  projects       Project[]
}

enum SkillCategory {
  LANGUAGE
  FRAMEWORK
  TOOL
  CONCEPT
  SOFT_SKILL
}

model Skill {
  id             String             @id @default(uuid())
  name           String             @unique
  category       SkillCategory
  createdAt      DateTime           @default(now())
  candidateSkills CandidateSkill[]
  projectSkills  ProjectSkill[]
  opportunitySkills OpportunitySkill[]
}

model CandidateSkill {
  profileId   String
  skillId     String
  proficiency String?
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill       Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
}

model Project {
  id            String         @id @default(uuid())
  profileId     String
  profile       Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name          String
  description   String
  githubUrl     String?
  liveUrl       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  projectSkills ProjectSkill[]
}

model ProjectSkill {
  projectId String
  skillId   String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
}

enum OpportunityType {
  INTERNSHIP
  JOB
  HACKATHON
  WORKSHOP
  OPEN_SOURCE
  MICRO_INTERNSHIP
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
  UNKNOWN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  UNKNOWN
}

enum ExperienceLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
  UNKNOWN
}

model Opportunity {
  id                String             @id @default(uuid())
  title             String
  organization      String
  description       String
  type              OpportunityType
  location          String?
  workMode          WorkMode           @default(UNKNOWN)
  employmentType    EmploymentType     @default(UNKNOWN)
  experienceLevel   ExperienceLevel    @default(UNKNOWN)
  applicationUrl    String
  source            String
  sourceUrl         String?
  sourceJobId       String?
  postedDate        DateTime?
  deadline          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  opportunitySkills OpportunitySkill[]

  @@unique([source, sourceJobId])
  @@index([type])
  @@index([workMode])
  @@index([employmentType])
  @@index([experienceLevel])
  @@index([location])
  @@index([postedDate])
  @@index([deadline])
}

enum RequirementType {
  REQUIRED
  PREFERRED
}

model OpportunitySkill {
  opportunityId   String
  skillId         String
  requirementType RequirementType
  opportunity     Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skill           Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([opportunityId, skillId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
